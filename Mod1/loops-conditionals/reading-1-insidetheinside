quiz(".recall","#recfb","5",{4:"range(5) starts at 0 and stops before 5, producing 0, 1, 2, 3, 4 — five values.",5:"range(5) produces five values: 0 through 4.",6:"The stop value 5 is not included, so there are five values, not six."});
quiz(".orderq","#orderfb","complete",{complete:"For each outer pass, Python runs the entire inner loop before the outer loop advances.",alternate:"The loops do not take turns. The inner loop completes before the next outer pass.",once:"The inner loop restarts for every outer pass."});
quiz(".countq","#countfb","8",{8:"4 outer passes × 2 inner passes each = 8 executions of the print.",6:"Adding 4 + 2 gives 6, but nested repetition means two inner executions happen for each of four outer passes.",4:"That counts only the outer passes. Each outer pass contains two inner passes."});
quiz(".indentq","#indentfb","2",{2:"The line is indented inside the outer loop but not the inner loop, so it runs once for each of 2 teams.",3:"Three is the inner-loop count, but this print sits outside the inner loop.",6:"Six is how often the inner print runs. The less-indented line runs only once per outer pass."});
quiz(".gateq","#gatefb","skip",{skip:"The inner check lives inside the true outer branch, so it is unreachable when the outer condition is false.",check:"Python only evaluates code in the branch execution enters.",error:"Skipping an unreachable inner branch is normal control flow, not an error."});
quiz(".condq","#condfb","standard",{standard:"The outer condition is true. Then 7 >= 10 is false, so the inner else branch prints standard.",bonus:"The outer branch is entered, but 7 is not at least 10.",inactive:"The outer condition is true, so the outer else branch is skipped."});
quiz(".comboq","#combofb","no",{no:"For the SMS item, channel == EMAIL is false, so execution never reaches the nested enabled check.",yes:"The loop visits every item, but conditionals still control which nested code is reached."});
quiz(".debugq","#debugfb","outer",{outer:"Trace from outside inward. If the outer branch is never entered, its inner check cannot run.",random:"Python follows deterministic control flow; random skipping is not the explanation.",import:"Nested conditionals are normal Python syntax and require no special import."});
quiz(".bridgeq","#bridgefb","label",{label:"The waiting check is nested inside the URGENT branch, so first determine whether that branch is entered.",waiting:"That inner question is only relevant after the outer label check succeeds.",all:"Nesting means the inner condition is reached only through its containing outer branch."});
